# ------------------------------------------------------------------------------
# HaberSite API — Ortam değişkenleri
# Kopyala: cp .env.example .env  ve production'da mutlaka SECRET'ları değiştir.
# ------------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development                            # development | staging | production
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/habersite?schema=public"

# --- Auth ---
JWT_SECRET="change-me-to-a-strong-secret"       # PROD: `openssl rand -hex 64`
JWT_EXPIRATION="7d"
JWT_REFRESH_SECRET="another-long-random-string" # Refresh token için ayrı secret
JWT_REFRESH_EXPIRATION="30d"

# --- CORS ---
# Virgülle ayrılmış origin listesi. Boş bırakılırsa localhost:3000-3010 kabul edilir.
CORS_ORIGIN=

# --- Storage (medya) ---
# Değerler: local (default), s3, cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE=20971520                        # 20MB (byte)

# S3 (STORAGE_DRIVER=s3 ise)
AWS_REGION=eu-west-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudinary (STORAGE_DRIVER=cloudinary ise)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Push notifications ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- SMTP (password reset, newsletters) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HaberSite <noreply@habersite.com>"

# --- Observability ---
SENTRY_DSN=                                     # boş = disabled
LOG_LEVEL=info                                  # error | warn | info | debug

# --- Backup ---
BACKUP_DIR=./backups
